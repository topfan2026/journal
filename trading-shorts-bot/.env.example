# Copy to .env and fill in:   cp .env.example .env
# Never commit .env.

# ---------- Folders & behaviour ----------
# Ready/ Processing/ Done/ Failed/ logs/ live here
SHORTS_ROOT=~/TradingShorts
# remove any you don't want
PLATFORMS=youtube,instagram,tiktok
# files must be unchanged this long before a job starts
STABLE_SECONDS=10
POLL_SECONDS=5
MAX_DURATION=60
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
# true = run the full pipeline but skip real uploads
DRY_RUN=false
# sets YouTube "altered/synthetic" + TikTok AIGC labels
AI_GENERATED=true
DISCLAIMER=Not financial advice. For education only.

# ---------- Claude (copywriter agent) ----------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
# fill | always | off
METADATA_MODE=fill
CHANNEL_STYLE=Educational day-trading strategy shorts, British presenter, clear and practical.

# ---------- YouTube (Data API v3) ----------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# filled by: python auth_setup.py youtube
YOUTUBE_REFRESH_TOKEN=
# public | unlisted | private
YOUTUBE_PRIVACY=public
# 27 = Education
YOUTUBE_CATEGORY_ID=27

# ---------- Instagram (Graph API, Reels) ----------
# only needed for auth_setup.py instagram
FB_APP_ID=
FB_APP_SECRET=
# filled by: python auth_setup.py instagram
IG_USER_ID=
IG_TOKEN=
IG_GRAPH_HOST=graph.facebook.com
IG_API_VERSION=v23.0

# ---------- TikTok (Content Posting API) ----------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# must exactly match the one registered in the TikTok app
TIKTOK_REDIRECT_URI=
# filled/refreshed automatically
TIKTOK_TOKEN=
TIKTOK_TOKEN_EXPIRES_AT=
# filled by: python auth_setup.py tiktok
TIKTOK_REFRESH_TOKEN=
# inbox (pre-audit, you tap Post in the app) | direct
TIKTOK_MODE=inbox
# direct mode; PUBLIC_TO_EVERYONE after app audit
TIKTOK_PRIVACY_LEVEL=SELF_ONLY
