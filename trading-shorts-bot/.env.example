# Copy to .env and fill in:   cp .env.example .env
# Never commit .env.

# ---------- Folders & behaviour ----------
# Ready/ Processing/ Done/ Failed/ logs/ live here
SHORTS_ROOT=~/TradingShorts
# remove any you don't want
PLATFORMS=youtube,instagram,tiktok
# files must be unchanged this long before a job starts
STABLE_SECONDS=10
POLL_SECONDS=5
MAX_DURATION=60
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
# true = run the full pipeline but skip real uploads
DRY_RUN=false
# sets YouTube "altered/synthetic" + TikTok AIGC labels
AI_GENERATED=true
DISCLAIMER=Not financial advice. For education only.

# ---------- Claude (copywriter agent) ----------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
# fill | always | off
METADATA_MODE=fill
CHANNEL_STYLE=Educational day-trading strategy shorts, British presenter, clear and practical.

# ---------- YouTube (Data API v3) ----------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# filled by: python auth_setup.py youtube
YOUTUBE_REFRESH_TOKEN=
# public | unlisted | private
YOUTUBE_PRIVACY=public
# 27 = Education
YOUTUBE_CATEGORY_ID=27

# ---------- Instagram (Graph API, Reels) ----------
# only needed for auth_setup.py instagram
FB_APP_ID=
FB_APP_SECRET=
# filled by: python auth_setup.py instagram
IG_USER_ID=
IG_TOKEN=
IG_GRAPH_HOST=graph.facebook.com
IG_API_VERSION=v23.0

# ---------- TikTok (Content Posting API) ----------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# must exactly match the one registered in the TikTok app
TIKTOK_REDIRECT_URI=
# filled/refreshed automatically
TIKTOK_TOKEN=
TIKTOK_TOKEN_EXPIRES_AT=
# filled by: python auth_setup.py tiktok
TIKTOK_REFRESH_TOKEN=
# inbox (pre-audit, you tap Post in the app) | direct
TIKTOK_MODE=inbox
# direct mode; PUBLIC_TO_EVERYONE after app audit
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# ========== Daily live stream (python live.py daemon) ==========
# ---------- Schedule ----------
LIVE_START=06:00
# mon-fri | mon,wed,fri | mon-sun
LIVE_DAYS=mon-fri
# empty = this computer's time zone; or e.g. America/New_York, Europe/London
LIVE_TZ=
# stop at this time (HH:MM) ...
LIVE_END=10:00
# ... or after this many minutes when LIVE_END is empty
LIVE_DURATION_MIN=240
# start the Gateway / browser / OBS this many minutes before LIVE_START
LIVE_PREP_MIN=10
# Windows: wake the PC from sleep 10 minutes before setup (the app creates the task on Save)
LIVE_WAKE=false

# ---------- IB Gateway via IBC (https://github.com/IbcAlpha/IBC) ----------
# your PAPER trading username and password (not the live login)
IB_USERNAME=
IB_PASSWORD=
# folder where IBC is unzipped, e.g. /opt/ibc  or  C:/IBC
IBC_PATH=
# IB Gateway major version, e.g. 1030 for 10.30 (Help > About in Gateway)
TWS_MAJOR_VRSN=
# Gateway install folder; defaults: ~/Jts (Linux), ~/Applications (macOS), C:/Jts (Windows)
TWS_PATH=
# or your own full start command instead of the three settings above
IBC_START_CMD=
IB_HOST=127.0.0.1
# 4002 = Gateway paper. Must match the port your scanner site connects to.
IB_PORT=4002
# refuse to run if the logged-in account is not a paper (DU...) account
IB_REQUIRE_PAPER=true
# true blocks orders through the API; leave false if your scanner places paper trades
IB_READ_ONLY=false

# ---------- Scanner website ----------
SCANNER_URL=https://aialgopro.com
# visible text of the button that starts the scanner (or a CSS selector instead)
SCANNER_START_TEXT=
SCANNER_START_SELECTOR=
# optional: CSS selector that only appears once the scanner is running
SCANNER_READY_SELECTOR=
# typed into the site by the steps as {SCANNER_SECRET}
SCANNER_SECRET=
SCANNER_WARMUP_SECONDS=20
# chrome | msedge | chromium
BROWSER_CHANNEL=chrome
# optional: full path to a Chrome/Edge/Brave executable (overrides BROWSER_CHANNEL)
BROWSER_PATH=

# ---------- OBS (Tools > WebSocket Server Settings) ----------
# full path to OBS: C:/Program Files/obs-studio/bin/64bit/obs64.exe | /Applications/OBS.app | /usr/bin/obs
OBS_PATH=
OBS_WS_HOST=localhost
OBS_WS_PORT=4455
OBS_WS_PASSWORD=
# the scene with your Window Capture of the scanner browser
OBS_SCENE=

# ---------- YouTube Live ----------
# true = create a fresh titled broadcast every day (needs `python auth_setup.py youtube` again)
# false = just stream with the key you already put in OBS
YOUTUBE_LIVE_API=true
# {weekday} and {date} are filled in
LIVE_TITLE=LIVE Stock Scanner | {weekday} {date} | Pre-Market Movers
LIVE_DESCRIPTION=Live AI stock scanner every trading morning. Subscribe and turn on notifications.
LIVE_TAGS=stock scanner,day trading,premarket movers,stock market live,top gainers today
# privacy once the stream has looked right (OBS streaming, picture not black, YouTube receiving)
# for LIVE_PUBLIC_AFTER_MIN minutes; until then it is LIVE_START_PRIVACY. 0 = no check.
LIVE_PRIVACY=public
LIVE_START_PRIVACY=unlisted
LIVE_PUBLIC_AFTER_MIN=3
# optional 1280x720 jpg
LIVE_THUMBNAIL=
# filled automatically on first run
YOUTUBE_LIVE_STREAM_ID=

# ---------- TikTok (LIVE Studio; you press its Go LIVE) ----------
TIKTOK_STUDIO=false
TIKTOK_STUDIO_PATH=
TIKTOK_STUDIO_REMIND=true
TIKTOK_STUDIO_CLOSE_AT_END=true

# ---------- website scanner: helper programs (aialgopro.com needs these to reach IB Gateway) ----------
# started (each in a minimised window) before the website opens, if not already running
SCANNER_CONNECTOR_CMD=
SCANNER_CONNECTOR_PORT=8765
SCANNER_TUNNEL_CMD=

# ---------- AI paper trader (paper account only) ----------
TRADER_ENABLED=false
TRADER_MODE=watch            # watch = commentary only, paper = paper orders
TRADER_STRATEGIES=orb,vwap
TRADER_MAX_TRADES=5
TRADER_MAX_LOSSES=3
TRADER_RISK_USD=100
TRADER_MAX_POSITION_USD=10000
TRADER_ORB_MIN=5
TRADER_TARGET_R=2
TRADER_LAST_ENTRY_ET=11:30
TRADER_FLATTEN_ET=15:50
TRADER_OVERLAY=true
