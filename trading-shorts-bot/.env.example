# Copy to .env and fill in:   cp .env.example .env
# Never commit .env.

# ---------- Folders & behaviour ----------
SHORTS_ROOT=~/TradingShorts            # Ready/ Processing/ Done/ Failed/ logs/ live here
PLATFORMS=youtube,instagram,tiktok     # remove any you don't want
STABLE_SECONDS=10                      # files must be unchanged this long before a job starts
POLL_SECONDS=5
MAX_DURATION=60
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
DRY_RUN=false                          # true = run the full pipeline but skip real uploads
AI_GENERATED=true                      # sets YouTube "altered/synthetic" + TikTok AIGC labels
DISCLAIMER=Not financial advice. For education only.

# ---------- Claude (copywriter agent) ----------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
METADATA_MODE=fill                     # fill | always | off
CHANNEL_STYLE=Educational day-trading strategy shorts, British presenter, clear and practical.

# ---------- YouTube (Data API v3) ----------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=                 # filled by: python auth_setup.py youtube
YOUTUBE_PRIVACY=public                 # public | unlisted | private
YOUTUBE_CATEGORY_ID=27                 # 27 = Education

# ---------- Instagram (Graph API, Reels) ----------
FB_APP_ID=                             # only needed for auth_setup.py instagram
FB_APP_SECRET=
IG_USER_ID=                            # filled by: python auth_setup.py instagram
IG_TOKEN=
IG_GRAPH_HOST=graph.facebook.com
IG_API_VERSION=v23.0

# ---------- TikTok (Content Posting API) ----------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=                   # must exactly match the one registered in the TikTok app
TIKTOK_TOKEN=                          # filled/refreshed automatically
TIKTOK_TOKEN_EXPIRES_AT=
TIKTOK_REFRESH_TOKEN=                  # filled by: python auth_setup.py tiktok
TIKTOK_MODE=inbox                      # inbox (pre-audit, you tap Post in the app) | direct
TIKTOK_PRIVACY_LEVEL=SELF_ONLY         # direct mode; PUBLIC_TO_EVERYONE after app audit
