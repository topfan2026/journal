# Copy to .env and edit. .env is git-ignored.
IBKR_HOST=127.0.0.1
# 7497 = TWS paper, 7496 = TWS live, 4002 = IB Gateway paper, 4001 = IB Gateway live
IBKR_PORT=7497
IBKR_CLIENT_ID=2
IBKR_EXEC_CLIENT_ID=3
PAPER_TRADING=true
PORTFOLIO_VALUE_USD=25000
MAX_TRADE_SIZE_USD=2500
MAX_TRADES_PER_DAY=5
MAX_RISK_PER_TRADE_PCT=1.0
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional ntfy.sh fallback, e.g. https://ntfy.sh/my-secret-topic
NOTIFY_URL=
# Optional: where TWS / IB Gateway is installed, for the desktop shortcut (launch.py)
TWS_PATH=
