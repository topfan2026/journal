# Copy to .env and fill in:   copy .env.example .env   (Windows)   /   cp .env.example .env
# Never commit .env.
#
# YouTube: if ../trading-shorts-bot/.env already has YOUTUBE_CLIENT_ID, YOUTUBE_CLIENT_SECRET and
# YOUTUBE_REFRESH_TOKEN (from its live-streaming setup), they are used automatically and you can
# leave these three empty.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# filled by: python main.py auth   (only needed if the trading bot's token isn't reused)
YOUTUBE_CHAT_REFRESH_TOKEN=

# ---------- General ----------
# IANA zone for the Pomodoro clock and the trivia schedule, e.g. America/New_York, Europe/London
TIMEZONE=
# overlay + control page port (trading-shorts-bot's scanner connector uses 8765)
OVERLAY_PORT=8790
# off = never post in chat | minimal = a few posts a day (show starting, winner, AFFILIATE line)
BOT_CHAT=minimal

# ---------- YouTube API quota (Google Cloud: 10,000 units/day by default) ----------
# Shared with trading-shorts-bot when both use the same Google Cloud project: if both stream on
# the same day, lower this so the two together stay under your project's limit.
YOUTUBE_DAILY_QUOTA=10000
YOUTUBE_QUOTA_RESERVE=500
# Unit costs. Check https://developers.google.com/youtube/v3/determine_quota_cost and adjust.
YOUTUBE_LIST_COST=5
YOUTUBE_INSERT_COST=50
# fastest chat polling: during trivia / on the study stream (the study stream slows down
# automatically so the day's quota lasts, keeping enough for tonight's show)
TRIVIA_POLL_SECONDS=5
STUDY_POLL_SECONDS=20

# ---------- Folders (defaults are inside this folder) ----------
DATA_DIR=
MUSIC_DIR=
QUESTIONS_DIR=
PROFILES_DIR=
