{
  "name": "trading-platform",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite\" \"node server/index.js\"",
    "dev:web": "vite",
    "server": "node server/index.js",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "desktop": "vite build --base ./ && electron .",
    "dist": "vite build --base ./ && electron-builder --publish never"
  },
  "dependencies": {
    "electron-updater": "6.3.9",
    "express": "4.21.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "autoprefixer": "10.4.20",
    "concurrently": "9.0.1",
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "framer-motion": "11.11.9",
    "lightweight-charts": "4.2.1",
    "lucide-react": "0.453.0",
    "postcss": "8.4.47",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vitest": "2.1.4",
    "zustand": "4.5.5"
  },
  "description": "ChartDesk trading workspace",
  "author": "topfan2026",
  "main": "electron/main.js",
  "build": {
    "appId": "com.topfan2026.chartdesk",
    "productName": "ChartDesk",
    "files": [
      "dist/**",
      "electron/**",
      "server/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "artifactName": "ChartDesk-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.finance",
      "artifactName": "ChartDesk-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "category": "Finance",
      "artifactName": "ChartDesk-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "topfan2026",
      "repo": "journal",
      "releaseType": "release"
    },
    "executableName": "chartdesk"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/topfan2026/journal.git"
  }
}
